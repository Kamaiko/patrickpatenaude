{
  "name": "patrickpatenaude",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3004 -H 127.0.0.1",
    "build": "next build",
    "preview": "serve out -l 3005",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,css,json,md}": "prettier --write"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "lint-staged": "^17",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8",
    "serve": "^14.2.6",
    "simple-git-hooks": "^2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "simple-git-hooks",
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": "22.x"
  }
}
